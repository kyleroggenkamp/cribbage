{
  "name": "deer-camp-cribbage",
  "version": "0.0.0",
  "private": true,
  "description": "Deer Camp Cribbage — a mobile-first PWA for playing cribbage from separate deer stands.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deal": "npm run deal --workspace @deercamp/engine",
    "score": "npm run score --workspace @deercamp/engine"
  },
  "engines": {
    "node": ">=20"
  }
}
