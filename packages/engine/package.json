{
  "name": "@deercamp/engine",
  "version": "0.0.0",
  "description": "Deer Camp Cribbage rules engine and grader. Pure TypeScript, no UI or network code.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deal": "tsx src/cli/deal.ts",
    "score": "tsx src/cli/score.ts",
    "gen:baselines": "tsx scripts/generate-baselines.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
