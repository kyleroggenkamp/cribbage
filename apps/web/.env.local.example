# Copy to apps/web/.env.local and fill in from your Supabase project
# (Project Settings -> API). Both are PUBLIC (safe in the browser bundle);
# the service role key and VAPID private key are NEVER put here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
